# Скопируйте этот файл в .env и впишите свои значения.
# Токен бота: https://discord.com/developers/applications -> ваше приложение -> Bot -> Reset Token
DISCORD_TOKEN=вставьте_сюда_токен

# ID каналов (ПКМ по каналу -> «Копировать ID»; нужен включённый режим разработчика)
NEWS_CHANNEL_ID=000000000000000000
SVO_CHANNEL_ID=000000000000000000
HISTORY_CHANNEL_ID=000000000000000000

# Во сколько публиковать (по Москве), можно несколько через запятую: 09:00,18:00
POST_TIMES=09:00
